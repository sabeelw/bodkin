# --- network -----------------------------------------------------------------
# Leave RPC_URL empty to use the built-in public pair: publicnode for state reads
# (fast, no eth_getLogs) and the official Robinhood RPC for logs. Comma-separated,
# preferred first; add #nologs after an endpoint that refuses eth_getLogs.
RPC_URL=
# Detection by subscription. Empty = publicnode websocket. "off" = HTTP polling.
# Comma-separated for a race (publicnode, dRPC, your provider). Never put a live key here.
RPC_WS_URL=
POLL_MS=300

# Direct sequencer (AWS us-east-2, no Cloudflare). Writes only.
SEQUENCER_URL=https://sequencer.mainnet.chain.robinhood.com
# Optional sequencer feed. Empty = default wss://feed.mainnet.chain.robinhood.com. "off" to disable.
FEED_URL=
# After `bodkin helper deploy --live`.
HELPER_ADDRESS=

# --- wallet ------------------------------------------------------------------
# Only needed for `--live`, buy, sell, claim, helper deploy. Never commit this file.
PRIVATE_KEY=

# --- sniper ------------------------------------------------------------------
SNIPE_ETH=0.01
SNIPE_SLIPPAGE_BPS=300
# Ceiling for the live staircase (9900 / 618 / 19 / 0). 300 ≡ enter at second +2.
SNIPE_MAX_TAX_BPS=300
SNIPE_BUDGET_ETH=0.05
ENTRY_SECOND=2
MIN_TAXED_BUYERS_S1=0
MAX_EXEMPT_BUYS_S0=32
ABORT_IF_INSIDER_SOLD=true

# Burst: parallel sendRaw on warm sequencer conns. Conditional is a doctor probe, not the fire path.
BURST_MAX=8
BURST_LEAD_MS=150
BURST_CONNS=12

# --- exits -------------------------------------------------------------------
# Fraction of the remaining bag @ gain%. Rest at readyToGraduate / ≥90% or trail after graduation.
EXIT_LADDER=34@100,33@300
STALE_SEC=90
STALE_MIN_PROGRESS=0.02
TAKE_PROFIT_PCT=80
STOP_LOSS_PCT=35
TRAILING_PCT=25
MAX_HOLD_MIN=45

# --- alerts (optional) -------------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- board -------------------------------------------------------------------
BOARD_PORT=4663

RPC_IN_FLIGHT=3
RPC_SPACING_MS=50
RPC_LOGS_SPACING_MS=400

# Token links in the terminal and board. Handles only feed the sign-up line; empty drops it.
REF_AXIOM=phosphen
REF_FOMO=phosphenq
